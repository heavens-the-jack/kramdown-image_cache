#!/usr/bin/env bash
# Runs the tests without touching the host's Ruby environment.
#
# Passing the current user's UID/GID to the container keeps the files that
# bundle install generates (Gemfile.lock, .bundle/) from being owned by root
# (see docker-compose.yml).
set -euo pipefail
cd "$(dirname "$0")/.."

export DOCKER_TEST_UID="$(id -u)"
export DOCKER_TEST_GID="$(id -g)"

if docker compose version >/dev/null 2>&1; then
  docker compose run --rm test "$@"
else
  docker-compose run --rm test "$@"
fi
